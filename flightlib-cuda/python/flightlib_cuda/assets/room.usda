#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "Room" (
        instanceable = true
        prepend references = </Library/Room>
    )
    {
        float xformOp:rotateZ = 0
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]
    }
}

class Scope "Library"
{
    def Xform "Room"
    {
        def Cube "Floor" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            color3f[] primvars:displayColor = [(0.5, 0.54, 0.58)]
            double size = 1
            float3 xformOp:scale = (32, 24, 0.2)
            double3 xformOp:translate = (0, 0, -0.1)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "Ceiling" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            color3f[] primvars:displayColor = [(0.5, 0.54, 0.58)]
            double size = 1
            float3 xformOp:scale = (32, 24, 0.2)
            double3 xformOp:translate = (0, 0, 8.1)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "West" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            color3f[] primvars:displayColor = [(0.5, 0.54, 0.58)]
            double size = 1
            float3 xformOp:scale = (0.2, 24, 8)
            double3 xformOp:translate = (-16.1, 0, 4)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "East" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            color3f[] primvars:displayColor = [(0.5, 0.54, 0.58)]
            double size = 1
            float3 xformOp:scale = (0.2, 24, 8)
            double3 xformOp:translate = (16.1, 0, 4)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "South" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            color3f[] primvars:displayColor = [(0.5, 0.54, 0.58)]
            double size = 1
            float3 xformOp:scale = (32, 0.2, 8)
            double3 xformOp:translate = (0, -12.1, 4)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "North" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            color3f[] primvars:displayColor = [(0.5, 0.54, 0.58)]
            double size = 1
            float3 xformOp:scale = (32, 0.2, 8)
            double3 xformOp:translate = (0, 12.1, 4)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }
}
