# CUDA 13.3.1, Ubuntu 24.04, linux/amd64. The digest pins the exact base image.
FROM nvidia/cuda:13.3.1-devel-ubuntu24.04@sha256:03c372fd9c65fe7739279f8c65473b315dc61efaaffab03e1e65bc7be7aee61e

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        build-essential ca-certificates ccache cmake curl git ninja-build \
        libeigen3-dev libgtest-dev libopencv-dev libyaml-cpp-dev libzmq3-dev \
        pybind11-dev python3-dev python3-numpy python3-pytest python3-venv \
    && rm -rf /var/lib/apt/lists/*

# zmqpp 4.2.0 is used by the CPU library's Unity bridge at link time.
RUN mkdir /tmp/zmqpp \
    && curl --fail --silent --show-error --location --retry 3 \
        https://codeload.github.com/zeromq/zmqpp/tar.gz/f8ff127683dc555aa004c0e6e2b18d2354a375be \
        --output /tmp/zmqpp.tar.gz \
    && echo '341151c619f508e00438ad4af71f495c9bad78636792249736083479027568c5  /tmp/zmqpp.tar.gz' | sha256sum --check \
    && tar -xzf /tmp/zmqpp.tar.gz --strip-components=1 -C /tmp/zmqpp \
    && cmake -S /tmp/zmqpp -B /tmp/zmqpp/build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release -DZMQPP_BUILD_STATIC=OFF \
    && cmake --build /tmp/zmqpp/build --parallel 4 \
    && cmake --install /tmp/zmqpp/build \
    && ldconfig \
    && rm -rf /tmp/zmqpp /tmp/zmqpp.tar.gz
